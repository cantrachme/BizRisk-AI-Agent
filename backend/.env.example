APP_NAME=BizRisk AI Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://bizrisk:bizrisk@localhost:5432/bizrisk
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# LLM_PROVIDER: "mock" (default, deterministic offline path used by tests) or "anthropic".
LLM_PROVIDER=mock
# Model used when LLM_PROVIDER=anthropic (env-driven).
LLM_ANTHROPIC_MODEL=claude-opus-5
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# API key is read from the environment only (never stored in Settings):
# ANTHROPIC_API_KEY=sk-ant-...   (LLM_API_KEY is also accepted as an alias)

# --- Investigation graph tuning (all optional; defaults shown) ---
ENTITY_RESOLUTION_THRESHOLD=0.75   # 0.0-1.0; docs recommend 0.85 for production
MAX_QA_LOOPS=2                     # QA -> planner correction loops before release
MAX_RESEARCH_DEPTH=3
MAX_BROWSER_ACTIONS=20
MAX_RESEARCH_TASKS=15
MAX_LLM_CALLS=50
TOKEN_BUDGET=100000

# --- Browser research ---
PLAYWRIGHT_HEADLESS=true

# --- Security ---
# The /api/v1/test/* endpoints run agents without auth. MUST be false in
# production (also enforced: Settings rejects ENVIRONMENT=production with this on).
ENABLE_TEST_ENDPOINTS=true

# --- CORS (JSON list or comma-separated) ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
